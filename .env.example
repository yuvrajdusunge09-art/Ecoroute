# EcoRoute AI - Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///ecoroute.db

# ============================================
# Demo Mode
# ============================================
# Set to 'true' to use simulated data (no API keys required)
# Set to 'false' to use real API providers
DEMO_MODE=true

# ============================================
# API Keys (Optional - only needed when DEMO_MODE=false)
# ============================================
# Never commit actual API keys to version control
MAP_API_KEY=
WEATHER_API_KEY=
ROUTING_API_KEY=
AI_API_KEY=

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
